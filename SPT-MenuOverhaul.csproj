<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>MoxoPixel.MenuOverhaul</AssemblyName>
    <Description>MoxoPixel.MenuOverhaul</Description>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <Version>2.0.0</Version>
    <Authors>MoxoPixel, GrooveypenguinX</Authors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release</Configurations>
    <RootNamespace>MoxoPixel.MenuOverhaul</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <!-- SPT 5.0 runs EFT under IL2CPP with BepInEx 6 (BepInEx.Unity.IL2CPP) on .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Root of the SPT install. Defaults to the repo being cloned two folders below it; override with -p:SptPath=... -->
    <SptPath Condition="'$(SptPath)' == ''">$(MSBuildProjectDirectory)\..\..</SptPath>
    <BepInExCorePath>$(SptPath)\BepInEx\core</BepInExCorePath>
    <!-- Il2CppInterop proxy assemblies generated by BepInEx on first launch. -->
    <BepInExInteropPath>$(SptPath)\BepInEx\interop</BepInExInteropPath>
    <SptPluginsPath Condition="'$(SptPluginsPath)' == ''">$(SptPath)\BepInEx\plugins\spt</SptPluginsPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build\**" />
    <Compile Remove="Interfaces\**" />
    <EmbeddedResource Remove="build\**" />
    <EmbeddedResource Remove="Interfaces\**" />
    <None Remove="build\**" />
    <None Remove="Interfaces\**" />
    <None Include="build\postbuild-copy.cmd" />
    <None Update="Resources\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCorePath)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExCorePath)\Il2CppInterop.Runtime.dll" Private="false" />

    <Reference Include="$(SptPluginsPath)\SPTushonka.Common.dll" Private="false" />
    <Reference Include="$(SptPluginsPath)\SPTushonka.Reflection.dll" Private="false" />

    <Reference Include="$(BepInExInteropPath)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="&quot;$(ProjectDir)build\postbuild-copy.cmd&quot; &quot;$(TargetName)&quot; &quot;$(TargetDir)&quot; &quot;$(ProjectDir)&quot;" />
  </Target>
</Project>
